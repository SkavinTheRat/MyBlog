---
import links from '@/public/links.json'

import { Button, Collapse, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import FriendList from '@/components/links/FriendList.astro'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'friends', text: '友链' },
  { depth: 2, slug: 'gossips', text: 'Gossips' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]

const { friends } = links
---

<PageLayout title='About' {headings}>
  <p>哈尔滨工业大学智能科学专业在读。</p>
  <p>
    Motto: 日拱一卒，功不唐捐。
  </p>
  <Button title='回到首页' class='w-fit' href='/' variant='ahead' />

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li><b>Coding</b>：从 Python 开始。</li>
    <li><b>Game</b>：星际公民。</li>
    <li><b>Music</b>：见<a href='/music'>音乐板块</a>。</li>
    <li><b>Notes</b>：零碎想法写在<a href='/notes'>随记</a>里。</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      },
      {
        name: 'ChatGPT',
        description: 'AI Assistant',
        href: 'https://chatgpt.com/',
        icon: import('@/assets/tools/chatgpt.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Notion',
        description: 'Note Taking',
        href: 'https://www.notion.so/',
        icon: import('@/assets/tools/notion.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: '主力系统',
        href: 'https://www.microsoft.com/windows/windows-11',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <Substats
    stats={[
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#fb7299',
        link: 'https://space.bilibili.com/2023163677',
        text: 'fans',
        api: 'bilibili/2023163677'
      }
    ]}
  />
  <ul>
    <li>Email：<a href='mailto:zhao20231459@126.com'>zhao20231459@126.com</a></li>
    <li>学校邮箱：<a href='mailto:2026110073@stu.hit.edu.cn'>2026110073@stu.hit.edu.cn</a></li>
  </ul>

  {/* friends */}
  <h2 id='friends'>友链</h2>
  {
    friends[0].link_list.length > 0 ? (
      <FriendList list={friends[0]} />
    ) : (
      <p class='text-muted-foreground'>
        还没有友链。想交换的朋友可以到
        <a href='/links'>友链页</a> 申请。
      </p>
    )
  }

  {/* gossips */}
  <h2 id='gossips'>Gossips</h2>
  {/* TODO: 写下网名的故事，替换占位内容 */}
  <Collapse title='为什么叫 SkavinTheRat？'>
    说来话长，这里先挖个坑。（在 <code>src/pages/about/index.astro</code> 编辑这一段）
  </Collapse>

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <Timeline
    events={[
      {
        date: '2026-10-04',
        content:
          '上线：基于 <a href="https://astro.build/" target="_blank">Astro</a> 与 <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a> 搭建，米色 + 海报橙。'
      }
    ]}
  />
  <p>本站基于以下项目与服务：</p>
  <ul>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      Comment system: <a href='https://waline.js.org' target='_blank'>Waline</a>（待开启）
    </li>
    <li>Quotes: <a href='https://hitokoto.cn/' target='_blank'>一言</a></li>
  </ul>
</PageLayout>
