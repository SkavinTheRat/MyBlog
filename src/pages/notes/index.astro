---
import { getCollection, render } from 'astro:content'

import PageLayout from '@/layouts/CommonPage.astro'
import config from '@/site-config'

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const rendered = await Promise.all(
  notes.map(async (note) => {
    const { Content } = await render(note)
    return { note, Content }
  })
)

const fmt = (d: Date) =>
  d.toLocaleDateString(config.locale.dateLocale, config.locale.dateOptions as Intl.DateTimeFormatOptions)
---

<PageLayout title='随记'>
  <p class='text-muted-foreground'>
    短小的想法、即时的记录、不值得成文的碎片。不写长文压力，保持输出习惯。
  </p>

  {
    rendered.length === 0 && (
      <p class='text-muted-foreground mt-6'>还没有随记。在 src/content/notes/ 下新建一个 .md 文件就是第一条。</p>
    )
  }

  <div class='mt-6 flex flex-col'>
    {
      rendered.map(({ note, Content }) => (
        <article class='note-item'>
          <time datetime={note.data.publishDate.toISOString()}>{fmt(note.data.publishDate)}</time>
          {note.data.title && <h3 class='mt-1 text-lg font-medium'>{note.data.title}</h3>}
          <div class='prose mt-2 max-w-none text-base'>
            <Content />
          </div>
          {note.data.tags.length > 0 && (
            <div class='mt-2 flex gap-x-3'>
              {note.data.tags.map((tag) => (
                <span class='tag text-xs'>#{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</PageLayout>
