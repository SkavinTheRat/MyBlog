---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import riseImg from '@/assets/home/rise.jpg'
import config from '@/site-config'

const MAX_POSTS = 6
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

const MAX_NOTES = 3
const allNotes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const latestNotes = allNotes.slice(0, MAX_NOTES)
const noteDate = (d: Date) =>
  d.toLocaleDateString(config.locale.dateLocale, config.locale.dateOptions as Intl.DateTimeFormatOptions)

const languages = ['Python 学习中', 'C 语言']
const frontend = ['HTML / CSS / JS 入门', 'Astro']
const tools = ['VS Code', 'Obsidian', 'Git']
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='flex w-full flex-col'>
    {/* ============ Hero：编辑海报风 ============ */}
    <section class='hero' id='hero'>
      <div class='hero-meta'>
        <span>Harbin, China</span>
        <span class='divider'></span>
        <span>Est. 2026</span>
        <span class='divider'></span>
        <span>Edition 1</span>
      </div>

      <h1 class='hero-title'>
        <span class='row'><span>Skavin</span></span>
        <span class='row'><span class='accent'>The Rat</span></span>
      </h1>

      <div class='hero-art'>
        <Image
          src={riseImg}
          alt='Rise 主题插图：向上伸展的手与红色圆日'
          widths={[480, 736, 960, 1472]}
          sizes='(max-width: 768px) 82vw, 46vw'
          loading='eager'
          fetchpriority='high'
        />
      </div>

      <p class='hero-sub'>
        哈尔滨工业大学<strong>智能科学专业</strong>在读，编程初学者。
        这里记录我<strong>学习代码与人工智能</strong>的过程——
        折腾的每一步，都算数。
      </p>

      <div class='hero-cta'>
        <a class='btn-solid' href='/blog'>开始阅读 →</a>
        <a class='btn-line' href='/about'>了解关于我</a>
      </div>

      <div class='hero-bottom'>
        <span>Step Into It</span>
        <span class='scroll-hint hide-mobile'>Scroll</span>
        <span>Go All In</span>
      </div>
    </section>

    {/* ============ About 一句话声明（yiannifive 式） ============ */}
    <section class='home-section reveal'>
      <div class='section-head'>
        <h2>About</h2>
      </div>
      <p class='statement'>
        SkavinTheRat 是一名来自哈尔滨的本科生，<br />
        主修<em>智能科学</em>，正在学习用代码表达想法。
      </p>
      <div class='connect-row'>
        <a href='https://space.bilibili.com/2023163677' target='_blank' rel='noopener'>
          <Icon name='bilibili' class='size-4' /> Bilibili
        </a>
        <a href='mailto:zhao20231459@126.com'>
          <Icon name='email' class='size-4' /> Email
        </a>
        <a href='mailto:2026110073@stu.hit.edu.cn'>
          <Icon name='email' class='size-4' /> 学校邮箱
        </a>
      </div>
    </section>

    {/* ============ Posts ============ */}
    {
      allPostsByDate.length > 0 && (
        <section class='home-section reveal'>
          <div class='section-head'>
            <h2>Posts</h2>
            <Button title='全部文章' class='w-fit' href='/blog' variant='ahead' />
          </div>
          <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
            {allPostsByDate.map((p) => (
              <li class='flex flex-col gap-x-2 sm:flex-row'>
                <PostPreview post={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ============ 随记 ============ */}
    <section class='home-section reveal'>
      <div class='section-head'>
        <h2>随记 · Notes</h2>
        <Button title='全部随记' class='w-fit' href='/notes' variant='ahead' />
      </div>
      {
        latestNotes.length > 0 ? (
          <div>
            {latestNotes.map((note) => (
              <div class='note-item'>
                <time datetime={note.data.publishDate.toISOString()}>
                  {noteDate(note.data.publishDate)}
                </time>
                <p>{note.body?.trim().split('\n')[0]}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class='text-muted-foreground'>还没有随记，第一条很快就来。</p>
        )
      }
    </section>

    {/* ============ 音乐 ============ */}
    <section class='home-section reveal'>
      <div class='section-head'>
        <h2>音乐 · Music</h2>
        <Button title='进入板块' class='w-fit' href='/music' variant='ahead' />
      </div>
      <a class='music-card' href='/music'>
        <span class='eq'><i></i><i></i><i></i></span>
        <span>
          <span class='block font-medium'>最近在听</span>
          <span class='block text-sm text-muted-foreground'>我的听歌记录与歌单，正在整理中 →</span>
        </span>
      </a>
    </section>

    {/* ============ Education ============ */}
    <section class='home-section reveal'>
      <div class='section-head'>
        <h2>Education</h2>
      </div>
      <Card
        as='a'
        heading='哈尔滨工业大学（本部）'
        subheading='智能科学专业 · 本科在读'
        date='2026 年 9 月入学'
        href='https://www.hit.edu.cn'
        target='_blank'
      />
    </section>

    {/* ============ Skills（诚实清单，随学习扩充） ============ */}
    <section class='home-section reveal'>
      <div class='section-head'>
        <h2>Skills</h2>
      </div>
      <div class='flex flex-col gap-y-3'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Frontend' skills={frontend} />
        <SkillLayout title='Tools' skills={tools} />
      </div>
    </section>

    <Quote class='my-12' />
  </main>
</PageLayout>

{/* 滚动浮现：IntersectionObserver 驱动 */}
<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        }
      }
    },
    { threshold: 0.12 }
  )
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
</script>
